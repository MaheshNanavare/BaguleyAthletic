---
import { TEAMS, teamHref, type Team } from '../data/fixtures';

// The widget script finds its container by id (lrep + lrcode) and reads a global
// `lrcode`, so both scripts stay is:inline (unbundled, in this order, after the div),
// and there is only ever one FaFeed per page.
// The links inside the div are its no-script fallback; data-division names the league
// on the next-match panel fa-feed.js builds.
interface Props {
  team: Team;
}

const { team } = Astro.props;
---
<section class="fixtures-section container">
  <nav class="team-tabs" aria-label="Teams">
    {TEAMS.map((t) => (
      <a href={teamHref(t)} aria-current={t === team ? 'page' : undefined}>{t.name}</a>
    ))}
  </nav>
  <div class="fa-feed" data-division={team.divisionName}>
    <div id={`lrep${team.lrcode}`}>Data loading&hellip; <a href={team.division}>click here for {team.divisionName}</a><br><br><a href="https://www.thefa.com/FULL-TIME">FULL-TIME Home</a></div>
  </div>
  <p class="fa-source">Fixtures and results published live by the league through <a class="text-link" href={team.division} target="_blank" rel="noopener">FA Full-Time</a>.</p>
  <script is:inline set:html={`var lrcode = '${team.lrcode}'`}></script>
  <script is:inline src="https://fulltime.thefa.com/client/api/cs1.js"></script>
</section>

<script>
  import '../scripts/fa-feed.js';
</script>
