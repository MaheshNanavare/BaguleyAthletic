<script>
  // compact the header once the page moves (collapses the topline, tightens the nav).
  // The header is sticky, so compacting it shortens the page by ~52px and the browser pulls
  // scrollY back by as much. A single threshold would then flip straight back and flicker;
  // collapsing and expanding at points further apart than that shrink keeps it stable.
  const header = document.querySelector('.site-header');
  const COLLAPSE_AT = 96;
  const EXPAND_AT = 8;

  if (header) {
    const setHeaderState = () => {
      const y = window.scrollY;
      if (y > COLLAPSE_AT) header.classList.add('is-scrolled');
      else if (y < EXPAND_AT) header.classList.remove('is-scrolled');
    };
    setHeaderState();
    window.addEventListener('scroll', setHeaderState, { passive: true });
  }
</script>
