---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChairmanQuote from '../components/ChairmanQuote.astro';
import NewsBand from '../components/NewsBand.astro';
import NextMatch from '../components/NextMatch.astro';
import { getNews } from '../data/news';
import { PARTNERS } from '../data/partners';

const latest = (await getNews()).slice(0, 4);
---
<BaseLayout
  title="Baguley Athletic FC | Home of The Badgers"
  description="Baguley Athletic FC — home of The Badgers. Grassroots football in Wythenshawe, Manchester."
>
  <section class="hero container">
    <h1>Made in<br><em>Wythenshawe.</em></h1>
    <div class="hero-side">
      <p class="hero-intro">A progressive, community-driven club building a sustainable sporting institution. Affectionately known as <strong>The Badgers</strong>.</p>
      <div class="hero-actions">
        <a class="button button-dark" href="/fixtures">Fixtures &amp; results</a>
        <a class="text-link" href="#story">Our story</a>
      </div>
    </div>
  </section>

  <NewsBand id="news" heading="Latest news" stories={latest} />

  <section class="welcome container" id="story">
    <div class="welcome-story">
      <p class="section-mark">Our story</p>
      <h2>A club that<br>respects its roots.<br><em>And refuses<br>to stand still.</em></h2>
      <div class="intro-copy">
        <p>Guided by Club Chairman and former England international David Platt, we're combining professional governance with an elite-level focus to climb the non-league pyramid.</p>
        <p>From a complete football pathway to local community wealth building, everything we do is built around people, pride and the place we call home.</p>
        <a class="text-link" href="#contact">Become a Badger</a>
      </div>
    </div>
    <ChairmanQuote side quote="We are striving for progression and success.">
      <p>I'm delighted to become Chairman of Baguley Athletic FC, a club I've come to know well over the last two seasons. The ambition of our volunteers is highly motivating, and while my background is there for the players and management to draw upon, it's our off-field vision that will truly help us prosper.</p>
      <p>We'll achieve that by building an inclusive club, establishing a unified identity, and deeply supporting our local community.</p>
    </ChairmanQuote>
  </section>

  <NextMatch />

  <section class="partners container" id="partners">
    <p class="section-mark">Our partners</p>
    <p class="partners-lede">Front of shirt on both kits is gifted to local causes &mdash; <a class="text-link" href="/partners">meet our partners</a>. Everything else is <a class="text-link" href="/commercial">open for sponsorship</a>.</p>
    <div class="partner-row">
      {PARTNERS.map(({ slug, name, logo }) => (
        <a href={`/partners#${slug}`}><img src={logo} alt={name}></a>
      ))}
    </div>
  </section>
</BaseLayout>
