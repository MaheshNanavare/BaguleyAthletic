---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsBand from '../../components/NewsBand.astro';
import { getNews, excerpt, type Story } from '../../data/news';

export async function getStaticPaths() {
  const stories = await getNews();
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story, more: stories.filter((s) => s.id !== story.id).slice(0, 4) },
  }));
}

interface Props {
  story: Story;
  more: Story[];
}

const { story, more } = Astro.props;
const { title, summary, image, imageAlt } = story.data;
const { Content } = await render(story);
---
<BaseLayout title={`${title} | Baguley Athletic FC`} description={excerpt(story)}>
  <article>
    <header class="article-head container">
      <p class="section-mark">Club news</p>
      <h1>{title}</h1>
      {summary && <p class="lede">{summary}</p>}
    </header>

    <figure class="article-photo container">
      <img src={image} alt={imageAlt}>
    </figure>

    <div class="article-body container">
      <aside class="article-rail">
        <a class="text-link" href="/news">All news</a>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {more.length > 0 && <NewsBand id="more-news" heading="More news" stories={more} />}
</BaseLayout>
